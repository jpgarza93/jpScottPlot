<Window
    x:Class="Avalonia_Demo.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ScottPlot Avalonia Demo"
    Width="500"
    Height="700"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#9a4993"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>

        <!--  title  -->
        <DockPanel Background="#67217a" DockPanel.Dock="Top">
            <Image
                Name="LogoImage"
                Width="48"
                Margin="10,0,5,0"
                Source="avares://Avalonia Demo/Resources/scottplot-icon-rounded-border-128.png" />
            <StackPanel Margin="5">
                <Label
                    Margin="0"
                    Padding="0,5,0,0"
                    Content="ScottPlot Avalonia Demo"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="WhiteSmoke" />
                <Label
                    Name="Subtitle"
                    Margin="0"
                    Padding="0,0,0,10"
                    Content="ScottPlot.Avalonia Version ???"
                    FontSize="18"
                    FontWeight="Light"
                    Foreground="WhiteSmoke" />
            </StackPanel>
        </DockPanel>

        <!--  description  -->
        <TextBlock
            Padding="10,15"
            DockPanel.Dock="Top"
            FontSize="16"
            Foreground="WhiteSmoke"
            Opacity=".5"
            TextWrapping="Wrap">
            This application demonstrates Avalonia-specific concepts that affect how
            plots are displayed and interactive with in Avalonia.<LineBreak />
            <LineBreak />
            The main ScottPlot Demo application uses Windows Forms, but the concepts
            it demonstrates easily translate to other GUI frameworks,
            so Avalonia developers are encouraged to review both demo applications.</TextBlock>

        <!--  plot  -->
        <ScottPlot:AvaPlot Name="AvaPlot" />

    </DockPanel>
</Window>
